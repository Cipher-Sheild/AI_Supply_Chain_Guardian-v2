# Compose reads only the settings listed here; secrets are scoped per service.
POSTGRES_USER=guardian
POSTGRES_PASSWORD=
POSTGRES_DB=guardian
# Required: generate a local token with openssl rand -hex 32.
CALLBACK_TOKEN=
GUARDIAN_ENV=production
# Required for Compose: a separate deployment key, at least 32 bytes.
GUARDIAN_API_KEY=
# Prompt judge (the stack does not deploy Ollama itself).
LLM_PROVIDER=ollama
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TRUST_ENGINE_PORT=8000
DASHBOARD_PORT=3000
# Standalone only: process environment can set DATABASE_URL, REDIS_URL,
# detector *_URL settings and TRUST_ENGINE_CALLBACK_URL.
# Default standalone DB: sqlite+aiosqlite:////tmp/guardian-scans.sqlite3
# See docs/RUNTIME_CONFIGURATION.md for executable limits and policy settings.

# Optional request budgets (maximum dispatch 9s, per-detector 8s).
SCAN_WORKERS=4
MAX_BODY_BYTES=2097152
GLOBAL_AGENT_WORKERS=12
SCAN_DEADLINE_SECONDS=9
PENDING_TIMEOUT_SECONDS=180
SEMGREP_TIMEOUT_SECONDS=7
# Optional CIPHERGUARD_TIMEOUT_SECONDS, CODE_SECURITY_TIMEOUT_SECONDS,
# SECRET_DETECTION_TIMEOUT_SECONDS, DOCKER_SECURITY_TIMEOUT_SECONDS,
# WORKFLOW_CICD_TIMEOUT_SECONDS, LICENSE_COMPLIANCE_TIMEOUT_SECONDS,
# PROMPT_INJECTION_TIMEOUT_SECONDS default to 8.

# Optional synthetic-pilot learned scorer; weighted remains default pending independent validation
TRUST_SCORER=weighted
EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
PROMPT_JUDGE_WORKERS=1

# Grok judge: set LLM_PROVIDER=grok and choose an available XAI_MODEL.
XAI_API_KEY=
XAI_MODEL=

# Groq is a separate provider: LLM_PROVIDER=groq.
GROQ_API_KEY=
GROQ_MODEL=
